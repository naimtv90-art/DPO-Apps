# ==============================================================================
# DairyPureOrganic Milk Manager - Environment Configuration Template
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (Online PostgreSQL - Neon / Supabase / Render / Railway)
# Example PostgreSQL URL:
# postgresql://postgres:YOUR_PASSWORD@ep-sample-12345.ap-southeast-1.aws.neon.tech/dpo_milk_db?sslmode=require
DATABASE_URL=postgresql://username:password@hostname:5432/dpo_milk_db?sslmode=require

# JWT Authentication Secret Key (Generate a random 32+ character string)
JWT_SECRET=dairypureorganic_production_jwt_secret_key_change_me_987654321

# Allowed Frontend URL for CORS (Set to your Vercel or custom domain)
FRONTEND_URL=https://dairypureorganic-milk-manager.vercel.app

# Frontend Client API URL (Used during Vite build on Vercel)
VITE_API_URL=https://dpo-milk-manager-backend.onrender.com/api
